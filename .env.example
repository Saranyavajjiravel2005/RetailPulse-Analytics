# RetailPulse Analytics Root Environment Configuration Example
# Copy options to backend/.env and frontend/.env as needed.

# Backend Settings:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/retailpulse
# JWT_ACCESS_SECRET=your_jwt_access_secret_here
# JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Frontend Settings:
# VITE_API_URL=http://localhost:8000/api
